# ERIO configuration: service addresses only, never credentials (decision D-08).
# The defaults in packages/core/erio_core/settings.py already match a stack
# started with `docker compose up`, so you only need these to point a service
# running on your machine (outside Docker) somewhere else.

ERIO_ENVIRONMENT=local
ERIO_DATABASE_URL=postgresql://erio@localhost:5432/erio
ERIO_REDIS_URL=redis://localhost:6379/0
ERIO_OPENSEARCH_URL=http://localhost:9200
ERIO_S3_ENDPOINT_URL=http://localhost:9090
ERIO_RAW_BUCKET=erio-raw

# Website (web/): where the server-side code reaches the API.
ERIO_API_URL=http://localhost:8000
